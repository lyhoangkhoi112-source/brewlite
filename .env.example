# ==========================================
# CẤU HÌNH DATABASE (PostgreSQL)
# ==========================================
# Chạy local không Docker: dùng localhost:5432
DATABASE_URL="postgresql://dev:yourpassword@localhost:5432/brewlite?schema=public"

# ==========================================
# CẤU HÌNH BACKEND (NestJS - apps/api)
# ==========================================
PORT=3000
JWT_SECRET=super_secret_jwt_key_for_brewlite_2026
JWT_EXPIRATION=1d
LOGIN_MAX_FAILED_ATTEMPTS=5
# Each set of failed attempts triggers the next duration; after the listed durations, the account is blocked.
LOGIN_LOCKOUT_DURATIONS_MINUTES=1,5

# ==========================================
# CẤU HÌNH FRONTEND (Next.js - apps/web)
# ==========================================
PORT=3001
NEXT_PUBLIC_API_URL="http://localhost:3000"