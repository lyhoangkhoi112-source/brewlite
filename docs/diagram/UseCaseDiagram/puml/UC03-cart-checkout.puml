@startuml
left to right direction
title USE CASE 03 - QUẢN LÝ GIỎ HÀNG VÀ ĐẶT HÀNG

skinparam backgroundColor white
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
    BackgroundColor #EAF3FF
    BorderColor #2874A6
}
skinparam actorStyle awesome

actor "Khách hàng" as Customer
actor "Dịch vụ thanh toán\nmô phỏng" as PaymentService

rectangle "Hệ thống BrewLite\n- Giỏ hàng và đặt hàng -" {
    usecase "Quản lý giỏ hàng" as Cart
    usecase "Đặt đơn hàng" as PlaceOrder
    usecase "Xác nhận đơn hàng" as ConfirmOrder
    usecase "Thanh toán điện tử" as Payment
}

Customer -- Cart
Customer -- PlaceOrder
Customer -- ConfirmOrder
Customer -- Payment

Payment -- PaymentService

PlaceOrder ..> Cart : <<include>>
ConfirmOrder ..> PlaceOrder : <<include>>
Payment ..> PlaceOrder : <<extend>>
@enduml
