@startuml
left to right direction
title USE CASE 05 - QUẢN LÝ VÀ XỬ LÝ ĐƠN HÀNG

skinparam backgroundColor white
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
    BackgroundColor #EAF3FF
    BorderColor #2874A6
}
skinparam actorStyle awesome

actor "Nhân viên quầy" as Staff
actor "Quản lý cửa hàng" as Manager

rectangle "Hệ thống BrewLite\n- Quản lý đơn hàng -" {
    usecase "Xem danh sách đơn" as ViewOrders
    usecase "Cập nhật trạng thái đơn" as UpdateStatus
    usecase "Đăng nhập" as Login
}

Staff -- ViewOrders
Staff -- UpdateStatus
Staff -- Login

Manager -- ViewOrders
Manager -- UpdateStatus
Manager -- Login
@enduml
