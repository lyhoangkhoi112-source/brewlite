@startuml BrewLiteDeployment
!theme plain
title UML Deployment Diagram - BrewLite Production

left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam nodesep 40
skinparam ranksep 50
skinparam componentStyle uml2

skinparam node {
    BorderColor #245A81
    BackgroundColor #F4F8FC
}

skinparam cloud {
    BorderColor #4B6580
    BackgroundColor #F7FAFC
}

skinparam database {
    BorderColor #26734D
    BackgroundColor #ECF7EF
}

node "<<device>> Thiết bị người dùng" as ClientDevice {
    node "<<browser>> Trình duyệt / PWA" as Browser {
        component "BrewLite Web UI\nNext.js / React / Zustand" as WebUI
    }
}

package "PRODUCTION ENVIRONMENT" as Production {
    node "<<CDN / PaaS>> Vercel" as Vercel {
        component "Next.js Application\n(apps/web)" as NextApp
        artifact "Build Environment\nNEXT_PUBLIC_API_URL\n(public Render API URL)" as VercelEnv
    }

    node "<<PaaS / web service>> Render" as Render {
        component "NestJS REST API\n(apps/api)\nGET /health: Prisma DB ping" as NestAPI
        component "PaymentsService\n(mock, internal)" as MockPayments
        artifact "Runtime Environment / Secrets\nDATABASE_URL (Neon URL)\nJWT_SECRET / NODE_ENV\nMOCK_PAYMENTS_ENABLED / PORT" as RenderEnv
        artifact "Application logs\nstdout / stderr -> Render Logs" as ApiLogs
    }

    node "<<DBaaS>> Neon" as Neon {
        database "Managed PostgreSQL\nBrewLite" as NeonDB
        storage "<<persistent storage>>\nDatabase data and backups" as NeonStorage
    }

    NextApp -[hidden]right- NestAPI
    NestAPI -[hidden]right- NeonDB
}

package "CI ENVIRONMENT" as CIEnvironment {
    cloud "GitHub" as GitHub {
        folder "BrewLite Repository" as Repository {
            artifact "Source Code\napps/web / apps/api" as SourceCode
        }
        node "<<CI>> GitHub Actions" as GitHubActions {
            component "Backend CI\nLint / Tests / Build" as BackendCI
        }
        node "<<container registry>> GHCR" as GHCR {
            artifact "API Container Image\nbrewlite-api:<commit-sha>" as RegistryImage
        }
    }
}

package "LOCAL DEVELOPMENT ENVIRONMENT" as LocalEnvironment {
    node "<<device>> Developer Workstation" as DeveloperWorkstation {
        artifact "Monorepo and local .env" as LocalSource
        component "Next.js Web\nlocalhost:3001" as LocalWeb
        component "NestJS API\nlocalhost:3000" as LocalApi
        database "Local PostgreSQL\nlocalhost:5432" as LocalDB
    }
}

WebUI --> NextApp : HTTPS :443
WebUI --> NestAPI : HTTPS / REST :443
NestAPI --> MockPayments : Internal call
NestAPI -down-> NeonDB : PostgreSQL TLS :5432
NeonDB --> NeonStorage : Data

SourceCode --> BackendCI : Push / PR
BackendCI ..> RegistryImage : Build / push
LocalWeb --> LocalApi : HTTP :3000
LocalApi --> LocalDB : PostgreSQL :5432

legend bottom
  Production platforms: Vercel (Next.js), Render (NestJS API), Neon (PostgreSQL).
  Vercel sets NEXT_PUBLIC_API_URL; Render holds backend secrets and DATABASE_URL.
  Render checks GET /health; the API health check pings Neon through Prisma.
  GHCR stores the API image for the target Render deployment; neither step is configured.
  Existing GitHub Actions runs backend lint, tests and build only.
  Local, CI and Production are separate environments.
endlegend

@enduml
