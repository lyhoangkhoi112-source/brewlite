@startuml BrewLite_Deployment_Diagram
!theme plain
skinparam componentStyle uml2
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam node {
    BorderColor #2b2b2b
    BackgroundColor #fcfcfc
}

title UML Deployment Diagram - BrewLite System (Vercel + Render Production Architecture)

' ===================================================
' 1. MÔI TRƯỜNG PHÁT TRIỂN CỤC BỘ (LOCAL ENVIRONMENT)
' ===================================================
node "<<device>> Developer Workstation" as LocalDev {
    artifact "Monorepo Source Code\n(apps/web, apps/api, docs)" as LocalCode
    artifact "Local Config (.env)" as LocalEnv
    
    node "<<container environment>> Docker Desktop" {
        node "<<container>> brewlite-web (Next.js :3000)" as LocalWeb
        node "<<container>> brewlite-api (NestJS :3001)" as LocalApi
        node "<<container>> postgres:15-alpine" as LocalDBNode {
            database "Local PostgreSQL DB (:5432)" as LocalDB
        }
    }
    LocalCode ..> LocalWeb : bind mount
    LocalCode ..> LocalApi : bind mount
    LocalWeb --> LocalApi : HTTP / REST (Port 3001)
    LocalApi --> LocalDB : TCP (Port 5432)
}

' ===================================================
' 2. MÔI TRƯỜNG CI/CD (GITHUB CLOUD)
' ===================================================
cloud "<<cloud>> GitHub Services" as GitHubCloud {
    folder "Repository: brewlite" as GHRepo {
        artifact "Git Commits & PRs" as GHCommits
    }
    
    node "<<runner>> GitHub Actions CI Pipeline" as GHActions {
        component "Job 1: Lint & Code Style" as CILint
        component "Job 2: Unit & Integration Tests" as CITest
        component "Job 3: Build Verification" as CIBuild
        component "Job 4: Smoke Test (Health Check)" as CISmoke
    }
    
    node "<<registry>> GitHub Container Registry (GHCR)" as ContainerRegistry {
        artifact "Docker Image\n(brewlite-api:latest / SHA)" as APIImage
    }
}

' ===================================================
' 3. THIẾT BỊ NGƯỜI DÙNG (CLIENT ENVIRONMENT)
' ===================================================
node "<<device>> Client Mobile / Tablet" as ClientDevice {
    node "<<browser>> Web Browser" as Browser {
        component "<<PWA>> BrewLite Mobile UI\n(HTML5 / CSS3 / React / Zustand)" as ClientPWA
    }
}

' ===================================================
' 4. MÔI TRƯỜNG PRODUCTION THỰC TẾ (PRODUCTION CLOUD)
' ===================================================

' --- NỀN TẢNG VERCEL CHO FRONTEND ---
cloud "<<PaaS>> Vercel Edge Network" as VercelPlatform {
    node "<<edge service>> Vercel Deployment" as VercelNode {
        component "Next.js Static Assets & SSR Engine\n(apps/web)" as ProdNextJS
        artifact "Vercel Environment Variables\n(NEXT_PUBLIC_API_URL)" as VercelEnv
    }
}

' --- NỀN TẢNG RENDER CHO BACKEND & DATABASE ---
cloud "<<PaaS>> Render Cloud Platform" as RenderPlatform {

    ' Khối Web Service chạy Backend
    node "<<container>> Render Web Service (Docker)" as RenderBackendNode {
        component "NestJS REST API (apps/api)" as ProdNestJS
        component "Health Check Endpoint\n(GET /health)" as HealthCheck
        
        artifact "Render Environment Secrets" as RenderSecrets {
            file "DATABASE_URL (Internal)"
            file "JWT_SECRET"
            file "PORT = 3000"
            file "NODE_ENV = production"
        }
    }

    ' Khối Database nội bộ của Render
    node "<<managed service>> Render PostgreSQL" as RenderDBNode {
        database "brewlite_production_db" as ProdDB
        storage "<<persistent storage>>\nRender Data Disk Volume (Persistent)" as ProdVolume
    }
}

' ===================================================
' DỊCH VỤ BÊN NGOÀI (EXTERNAL SERVICES)
' ===================================================
cloud "<<external service>> Mock Payment Gateway" as MockPayment {
    component "Simulated Payment Service\n(E-Wallet / Bank Gateway)" as MockService
}

' ===================================================
' ĐƯỜNG DÂY VÀ GIAO THỨC KẾT NỐI (PROTOCOLS & FLOWS)
' ===================================================

' 1. Luồng đẩy mã nguồn và kích hoạt CI/CD
LocalCode --> GHCommits : git push
GHCommits --> GHActions : Trigger PR / Push
CIBuild --> ContainerRegistry : Push Docker Image (Optional)
GHActions --> RenderBackendNode : Trigger Deploy Webhook / Deploy Hook

' 2. Luồng Client truy cập ứng dụng
ClientPWA --> ProdNextJS : HTTPS (Port 443)\nFetch HTML / JS / PWA Manifest
ClientPWA --> ProdNestJS : HTTPS / REST API (Port 443)\nJSON Requests + JWT Header

' 3. Luồng nội bộ Render Cloud
RenderSecrets ..> ProdNestJS : Injected at Runtime
ProdDB --> ProdVolume : Mounts persistent storage
ProdNestJS --> ProdDB : PostgreSQL Wire Protocol\n(Port 5432 - Render Private Network)

' 4. Kết nối dịch vụ ngoài
ProdNestJS --> MockService : HTTPS / REST (Port 443)\nProcess simulated payment

' 5. Kiểm tra Health Check tự động
CISmoke --> HealthCheck : HTTPS GET /health\n(Post-Deploy Smoke Test)

@enduml