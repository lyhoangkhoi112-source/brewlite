@startuml Order_Processing_Payment_Fulfillment
title Order Processing, Payment & Fulfillment

skinparam conditionStyle inside diamond
skinparam defaultTextAlignment center

|Customer|
start
:View Cart;
:Proceed To Checkout;

|Backend|
:Verify Authentication Status;
if (Authenticated?) then (yes)
else (no)
    |Customer|
    :Login;
    
    |Backend|
    :Validate Credentials;
    if (Valid Credentials?) then (no)
        stop
    else (yes)
    endif
endif

:Validate Order Data;
:Check Inventory;

if (Stock Available?) then (no)
    |Frontend|
    :Display Out Of Stock Message;
    stop
else (yes)
    |Backend|
    :Create Order;
    :Generate Order ID;
endif

|Customer|
repeat
    :Select Payment Method;
    
    |Payment Gateway|
    :Process Payment;
    
    if (Payment Successful?) then (yes)
        |Backend|
        :Update Order Status -> PAID;
        :Store Payment Record;
        
        |Staff|
        :View New Order;
        :Accept Order;
        
        |Backend|
        :Update Status -> CONFIRMED;
        
        |Staff|
        :Prepare Beverage;
        :Mark Order Ready;
        
        |Backend|
        :Update Status -> READY;
        
        |Frontend|
        :Notify Customer;
        
        |Customer|
        :Receive Beverage;
        
        |Backend|
        :Update Status -> COMPLETED;
        stop
    else (no)
        |Frontend|
        :Display Payment Failed Message;
    endif

|Customer|

repeat while (Retry Payment?) is (yes)
->no;

|Backend|
:Update Order Status -> PAYMENT FAILED;
stop

@enduml