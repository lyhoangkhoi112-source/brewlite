@startuml User Login

|Customer|
start

:Open Login Page;
:Enter Email & Password;

|Frontend|
:Validate Input;

if (Input Valid?) then (Yes)

    |Backend|
    :Verify Credentials;

    if (Credentials Correct?) then (Yes)

        :Generate JWT Token;
        :Create User Session;

        |Customer|
        :Login Successful;
        :Access System;

        stop

    else (No)

        |Frontend|
        :Display Login Failed;
        stop

    endif

else (No)

    :Display Validation Error;
    stop

endif

@enduml