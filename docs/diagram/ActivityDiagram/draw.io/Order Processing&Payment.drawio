        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml Order_Processing_Payment_Fulfillment\ntitle Order Processing, Payment &amp; Fulfillment\n\nskinparam conditionStyle inside diamond\nskinparam defaultTextAlignment center\n\n|Customer|\nstart\n:View Cart;\n:Proceed To Checkout;\n\n|Backend|\n:Verify Authentication Status;\nif (Authenticated?) then (yes)\nelse (no)\n    |Customer|\n    :Login;\n    \n    |Backend|\n    :Validate Credentials;\n    if (Valid Credentials?) then (no)\n        stop\n    else (yes)\n    endif\nendif\n\n:Validate Order Data;\n:Check Inventory;\n\nif (Stock Available?) then (no)\n    |Frontend|\n    :Display Out Of Stock Message;\n    stop\nelse (yes)\n    |Backend|\n    :Create Order;\n    :Generate Order ID;\nendif\n\n|Customer|\nrepeat\n    :Select Payment Method;\n    \n    |Payment Gateway|\n    :Process Payment;\n    \n    if (Payment Successful?) then (yes)\n        |Backend|\n        :Update Order Status -&gt; PAID;\n        :Store Payment Record;\n        \n        |Staff|\n        :View New Order;\n        :Accept Order;\n        \n        |Backend|\n        :Update Status -&gt; CONFIRMED;\n        \n        |Staff|\n        :Prepare Beverage;\n        :Mark Order Ready;\n        \n        |Backend|\n        :Update Status -&gt; READY;\n        \n        |Frontend|\n        :Notify Customer;\n        \n        |Customer|\n        :Receive Beverage;\n        \n        |Backend|\n        :Update Status -&gt; COMPLETED;\n        stop\n    else (no)\n        |Frontend|\n        :Display Payment Failed Message;\n    endif\n\n|Customer|\nrepeat while (Retry Payment?) is (yes)\n-&gt;no;\n\n|Backend|\n:Update Order Status -&gt; PAYMENT FAILED;\nstop\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ZwNQLtFq7vm7ejNalI-9-327">
