@startuml BrewLiteClassDiagram
title Class Diagram - Mô hình dữ liệu BrewLite

left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam nodesep 45
skinparam ranksep 55

skinparam class {
    BackgroundColor #EAF3FF
    BorderColor #245A81
    FontColor #17365D
    ArrowColor #315A7D
}

skinparam enum {
    BackgroundColor #FFF2D8
    BorderColor #C58B25
    FontColor #654A13
}

hide empty members

package "Trạng thái và vai trò" {
    enum UserRole {
        CUSTOMER
        STAFF
        MANAGER
    }

    enum UserStatus {
        ACTIVE
        INACTIVE
        BLOCKED
    }

    enum ProductCategory {
        COFFEE
        MILK_TEA
        FRUIT_TEA
        MATCHA
        ICE_BLEND
        MACCHIATO
        PASTRIES
        TOPPING
    }

    enum ProductStatus {
        AVAILABLE
        UNAVAILABLE
        OUT_OF_STOCK
    }

    enum OrderStatus {
        PENDING
        CONFIRMED
        PREPARING
        READY
        DELIVERING
        COMPLETED
        CANCELLED
        PAYMENT_FAILED
    }

    enum PaymentMethod {
        CASH
        MOMO
        VNPAY
        CREDIT_CARD
        SHOPEEPAY
    }

    enum PaymentStatus {
        PENDING
        PROCESSING
        SUCCESS
        FAILED
        REFUNDED
        CANCELLED
    }

    enum LoyaltyTransactionType {
        EARN
        REDEEM
        EXPIRE
        ADJUST
    }
}

package "Dữ liệu nghiệp vụ - Prisma" {
    together {
        class User <<model>> {
            + id: String
            + fullName: String
            + email: String
            + phone: String?
            + role: UserRole
            + status: UserStatus
            + loyaltyPoints: Integer
        }

        class Order <<model>> {
            + id: String
            + orderCode: String
            + userId: String?
            + status: OrderStatus
            + totalAmount: Decimal
            + shippingAddress: String?
            + contactPhone: String?
            + deletedAt: DateTime?
        }

        class Product <<model>> {
            + id: String
            + name: String
            + category: ProductCategory?
            + basePrice: Decimal
            + stockQuantity: Integer
            + status: ProductStatus
        }
    }

    together {
        class LoyaltyTransaction <<model>> {
            + id: String
            + userId: String
            + orderId: String?
            + type: LoyaltyTransactionType
            + points: Integer
            + balanceAfter: Integer
            + createdAt: DateTime
        }

        class OrderItem <<model>> {
            + id: String
            + orderId: String
            + productId: String
            + productName: String
            + quantity: Integer
            + unitPrice: Decimal
            + selectedSize: String?
            + sugarLevel: String?
            + iceLevel: String?
            + selectedToppings: String?
            + subtotal: Decimal
        }

        class Payment <<model>> {
            + id: String
            + orderId: String
            + transactionId: String?
            + idempotencyKey: String
            + amount: Decimal
            + method: PaymentMethod
            + status: PaymentStatus
            + paidAt: DateTime?
        }
    }
}

package "Giỏ hàng - Frontend" {
    class CartStore <<Zustand persist>> {
        + items: CartItem[]
        + addItem(item)
        + updateQuantity(id, quantity)
        + removeItem(id)
        + clearCart()
    }

    class CartItem <<client state>> {
        + productId: String?
        + name: String
        + price: Number
        + quantity: Integer
        + selectedSize: String?
        + sugarLevel: String?
        + iceLevel: String?
        + selectedToppings: String[]?
    }
}

' Keep the core order flow together so its relationship lines stay short.
User "0..1" -- "0..*" Order : đặt
Order "1" *-- "1..*" OrderItem : gồm
Product "1" -- "0..*" OrderItem : sản phẩm
Order "1" *-- "0..*" Payment : thanh toán
User "1" -- "0..*" LoyaltyTransaction : điểm
Order "0..1" -- "0..*" LoyaltyTransaction : phát sinh
CartStore "1" *-- "0..*" CartItem : lưu

legend bottom
  Mã user: KH (CUSTOMER), NV (STAFF), QL (MANAGER).
  Mã đơn: HD########; xóa mềm không giải phóng mã.
  CartStore lưu ở localStorage với khóa "brewlite-cart",
  không lưu trong database.
endlegend

@enduml
