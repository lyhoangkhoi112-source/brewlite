  <diagram name="Page-1" id="e6Wa9vtH0AqmEHbqIVNt">
    <mxGraphModel dx="2094" dy="946" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml Class Diagram - Mô hình lớp nghiệp vụ BrewLite\n\nleft to right direction\nskinparam backgroundColor white\nskinparam shadowing false\nskinparam linetype ortho\nskinparam classAttributeIconSize 0\nskinparam packageStyle rectangle\nskinparam defaultFontName Arial\nskinparam defaultFontSize 12\n\nskinparam class {\n    BackgroundColor #EAF3FF\n    BorderColor #245A81\n    FontColor #17365D\n    ArrowColor #315A7D\n}\n\nskinparam enum {\n    BackgroundColor #FFF2D8\n    BorderColor #C58B25\n    FontColor #654A13\n}\n\nhide empty members\n\n&#39;========================================\n&#39; ENUM - CAC TRANG THAI\n&#39;========================================\n\npackage \&quot;Enumerations - Các kiểu liệt kê\&quot; {\n\n    enum UserRole {\n        CUSTOMER\n        STAFF\n        MANAGER\n    }\n\n    enum UserStatus {\n        ACTIVE\n        INACTIVE\n        BLOCKED\n    }\n\n    enum ProductStatus {\n        AVAILABLE\n        UNAVAILABLE\n        OUT_OF_STOCK\n    }\n\n    enum OrderStatus {\n        PENDING\n        CONFIRMED\n        PREPARING\n        READY\n        DELIVERING\n        COMPLETED\n        CANCELLED\n        PAYMENT_FAILED\n    }\n\n    enum PaymentMethod {\n        MOMO\n        VNPAY\n        ZALOPAY\n    }\n\n    enum PaymentStatus {\n        PENDING\n        PROCESSING\n        SUCCESS\n        FAILED\n        REFUNDED\n    }\n\n    enum PromotionType {\n        PERCENTAGE\n        FIXED_AMOUNT\n    }\n\n    enum LoyaltyTransactionType {\n        EARN\n        REDEEM\n        EXPIRE\n        ADJUST\n    }\n}\n\n&#39;========================================\n&#39; CAC LOP NGHIEP VU\n&#39;========================================\n\npackage \&quot;Core Domain - Lớp nghiệp vụ\&quot; {\n\n    class User {\n        - id: UUID\n        - fullName: String\n        - email: String\n        - passwordHash: String\n        - phone: String\n        - role: UserRole\n        - status: UserStatus\n        - createdAt: DateTime\n        + register()\n        + login()\n        + updateProfile()\n    }\n\n    class Product {\n        - id: UUID\n        - name: String\n        - description: String\n        - basePrice: Decimal\n        - stockQuantity: Integer\n        - imageUrl: String\n        - status: ProductStatus\n        + getDetails()\n        + checkStock(quantity): Boolean\n        + updateStock(quantity)\n    }\n\n    class Cart {\n        - id: UUID\n        - createdAt: DateTime\n        - updatedAt: DateTime\n        + addItem(product, quantity)\n        + updateQuantity(productId, quantity)\n        + removeItem(productId)\n        + calculateTotal(): Decimal\n        + clear()\n    }\n\n    class CartItem {\n        - id: UUID\n        - quantity: Integer\n        - selectedSize: String\n        - selectedToppings: String\n        - unitPrice: Decimal\n        + calculateSubtotal(): Decimal\n    }\n\n    class Order {\n        - id: UUID\n        - orderCode: String\n        - status: OrderStatus\n        - subtotal: Decimal\n        - discountAmount: Decimal\n        - totalAmount: Decimal\n        - shippingAddress: String\n        - note: String\n        - createdAt: DateTime\n        - updatedAt: DateTime\n        + calculateTotal(): Decimal\n        + confirm()\n        + cancel()\n        + updateStatus(status)\n    }\n\n    class OrderItem {\n        - id: UUID\n        - productName: String\n        - quantity: Integer\n        - unitPrice: Decimal\n        - selectedSize: String\n        - selectedToppings: String\n        - subtotal: Decimal\n        + calculateSubtotal(): Decimal\n    }\n\n    class Payment {\n        - id: UUID\n        - transactionId: String\n        - idempotencyKey: String\n        - amount: Decimal\n        - method: PaymentMethod\n        - status: PaymentStatus\n        - failureReason: String\n        - paidAt: DateTime\n        + process()\n        + markSuccess(transactionId)\n        + markFailed(reason)\n        + refund()\n    }\n\n    class Promotion {\n        - id: UUID\n        - code: String\n        - description: String\n        - type: PromotionType\n        - value: Decimal\n        - minimumOrderAmount: Decimal\n        - startAt: DateTime\n        - endAt: DateTime\n        - usageLimit: Integer\n        - usedCount: Integer\n        - isActive: Boolean\n        + isValid(orderAmount): Boolean\n        + calculateDiscount(orderAmount): Decimal\n    }\n\n    class LoyaltyTransaction {\n        - id: UUID\n        - type: LoyaltyTransactionType\n        - points: Integer\n        - balanceAfter: Integer\n        - description: String\n        - createdAt: DateTime\n        + earnPoints()\n        + redeemPoints()\n    }\n}\n\n&#39;========================================\n&#39; QUAN HE GIUA CAC LOP\n&#39;========================================\n\n&#39; Khach hang co gio hang\nUser \&quot;1\&quot; -- \&quot;0..1\&quot; Cart : sở hữu\n\n&#39; Gio hang gom nhieu dong hang\nCart \&quot;1\&quot; *-- \&quot;0..*\&quot; CartItem : chứa\n\n&#39; Moi dong gio hang tham chieu mot san pham\nProduct \&quot;1\&quot; -- \&quot;0..*\&quot; CartItem : được chọn\n\n&#39; Khach hang tao don hang\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; Order : đặt\n\n&#39; Don hang gom cac dong chi tiet\nOrder \&quot;1\&quot; *-- \&quot;1..*\&quot; OrderItem : gồm\n\n&#39; Moi dong don hang tham chieu san pham\nProduct \&quot;1\&quot; -- \&quot;0..*\&quot; OrderItem : sản phẩm\n\n&#39; Mot don co the co nhieu lan thu thanh toan\nOrder \&quot;1\&quot; -- \&quot;0..*\&quot; Payment : thanh toán\n\n&#39; Ma khuyen mai co the duoc ap dung cho nhieu don\nPromotion \&quot;0..1\&quot; -- \&quot;0..*\&quot; Order : áp dụng\n\n&#39; Lich su diem thuoc ve mot tai khoan\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; LoyaltyTransaction : tích điểm\n\n&#39; Ghi chu:\n&#39; OrderItem luu ten va don gia tai thoi diem dat hang.\n&#39; Payment.idempotencyKey giup tranh xu ly thanh toan lap.\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="34kA07qAdfkRmYhgVtQQ-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
