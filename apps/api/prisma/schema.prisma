datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ========================================
// ENUMS
// ========================================

enum UserRole {
  CUSTOMER
  STAFF
  MANAGER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum ProductStatus {
  AVAILABLE
  UNAVAILABLE
  OUT_OF_STOCK
}

enum ProductCategory {
  COFFEE
  MILK_TEA
  FRUIT_TEA
  MATCHA
  ICE_BLEND
  MACCHIATO
  TOPPING
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  DELIVERING
  COMPLETED
  CANCELLED
  PAYMENT_FAILED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CASH
  MOMO
  VNPAY
  CREDIT_CARD
  SHOPEEPAY
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  EXPIRE
  ADJUST
}

// ========================================
// MODELS (TABLES)
// ========================================

model User {
  id           String      @id @default(uuid())
  fullName     String
  email        String      @unique
  passwordHash String
  phone        String?
  role         UserRole    @default(CUSTOMER)
  status       UserStatus  @default(ACTIVE)
  createdAt    DateTime    @default(now())
  failedLoginAttempts Int      @default(0)
  loginLockoutStage   Int      @default(0)
  lockedUntil         DateTime?
  loyaltyPoints       Int         @default(0)

  cart                Cart?
  orders              Order[]
  loyaltyTransactions LoyaltyTransaction[]
}

model Product {
  id            String        @id @default(uuid())
  name          String
  description   String?
  category      ProductCategory?
  basePrice     Decimal       @db.Decimal(12, 2)
  stockQuantity Int           @default(0)
  imageUrl      String?
  status        ProductStatus @default(AVAILABLE)

  cartItems  CartItem[]
  orderItems OrderItem[]
}

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique // 1 User có 0..1 Cart
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CartItem[]
}

model CartItem {
  id               String   @id @default(uuid())
  cartId           String
  cart             Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId        String
  product          Product  @relation(fields: [productId], references: [id])
  quantity         Int      @default(1)
  selectedSize     String?
  sugarLevel       String?
  iceLevel         String?
  selectedToppings String?
  unitPrice        Decimal  @db.Decimal(12, 2)
}

model Order {
  id              String      @id @default(uuid())
  orderCode       String      @unique
  guestAccessTokenHash String? @unique
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  promotionId     String?
  promotion       Promotion?  @relation(fields: [promotionId], references: [id])
  status          OrderStatus @default(PENDING)
  subtotal        Decimal     @db.Decimal(12, 2)
  discountAmount  Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal     @db.Decimal(12, 2)
  shippingAddress String?
  contactPhone    String?
  note            String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  orderItems OrderItem[]
  payments   Payment[]
  loyaltyTransactions LoyaltyTransaction[]
}

model OrderItem {
  id               String   @id @default(uuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product  @relation(fields: [productId], references: [id])
  productName      String   // Snapshot lại tên món thời điểm đặt
  quantity         Int
  unitPrice        Decimal  @db.Decimal(12, 2)
  selectedSize     String?
  sugarLevel       String?
  iceLevel         String?
  selectedToppings String?
  subtotal         Decimal  @db.Decimal(12, 2)
}

model Payment {
  id             String        @id @default(uuid())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transactionId  String?       @unique
  idempotencyKey String        @unique
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  failureReason  String?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
}

model Promotion {
  id                 String        @id @default(uuid())
  code               String        @unique
  description        String?
  type               PromotionType
  value              Decimal       @db.Decimal(12, 2)
  minimumOrderAmount Decimal       @default(0) @db.Decimal(12, 2)
  startAt            DateTime
  endAt              DateTime
  usageLimit         Int?
  usedCount          Int           @default(0)
  isActive           Boolean       @default(true)

  orders Order[]
}

model LoyaltyTransaction {
  id           String                 @id @default(uuid())
  userId       String
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId      String?                @unique
  order        Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type         LoyaltyTransactionType
  points       Int
  balanceAfter Int
  description  String?
  createdAt    DateTime               @default(now())
}
